{
  "name": "avisos-el-campello",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PWA para enviar avisos de incidencias en la vía pública al Ayuntamiento de El Campello",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "dev": "npm run vendor && wrangler dev",
    "deploy": "npm run vendor && wrangler deploy",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "jspdf": "^2.5.2",
    "leaflet": "^1.9.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidcasanovasola-git/avisos-el-campello.git"
  },
  "homepage": "https://avisos-el-campello.davidcasanovasola.workers.dev"
}
